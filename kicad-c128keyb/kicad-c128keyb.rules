
(rules PCB kicad-c128keyb
  (snap_angle 
    fortyfive_degree
  )
  (autoroute_settings
    (fanout off)
    (autoroute on)
    (postroute on)
    (vias on)
    (via_costs 1)
    (plane_via_costs 1)
    (start_ripup_costs 1)
    (start_pass_no 3714)
    (layer_rule F.Cu
      (active on)
      (preferred_direction horizontal)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.0)
    )
    (layer_rule B.Cu
      (active on)
      (preferred_direction vertical)
      (preferred_direction_trace_costs 1.0)
      (against_preferred_direction_trace_costs 1.0)
    )
  )
  (rule
    (width 250.0)
    (clearance 200.2)
    (clearance 125.0 (type smd_to_turn_gap))
    (clearance 200.2 (type smd))
    (clearance 200.2 (type "kicad_default"))
    (clearance 200.2 (type kicad))
  )
  (padstack "Via[0-1]_800:400_um"
    (shape
      (circle F.Cu 800.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 800.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_800:400_um" "Via[0-1]_800:400_um" default
  )
  (via 
    "Via[0-1]_800:400_um-kicad_default" "Via[0-1]_800:400_um" "kicad_default"
  )
  (via_rule
    default "Via[0-1]_800:400_um"
  )
  (via_rule
    "kicad_default" "Via[0-1]_800:400_um-kicad_default"
  )
  (class default
    GND VCC /PB3 /PB6 /PB5 /PB4 /PB7 /PB2
    /PB1 /PB0 /PA0 /PA6 /PA5 /PA4 /PA3 /PA2
    /PA1 /PA7 /AX1 "/~{RESTORE_3V}" /RESET /STROBE /DATA "/SH_CP"
    "/ST_CP" /DS +3V3 /SCL /SDA /AX2 /AY0 /AY1
    /AY2 /AX0
    (clearance_class default)
    (via_rule default)
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
  (class "kicad_default"
    /~{RESTORE} "unconnected-(J2-Pin_2-Pad2)" "unconnected-(J5-Pin_2-Pad2)" "unconnected-(J5-Pin_20-Pad20)" "unconnected-(J5-Pin_5-Pad5)" "Net-(Q1-B)" "unconnected-(U2-QG-Pad6)" "unconnected-(U2-QH'-Pad9)"
    "unconnected-(U2-QH-Pad7)" "unconnected-(U3-PA5_A9_D9_MISO-Pad10)" "unconnected-(U3-PA6_A10_D10_MOSI-Pad11)"
    (clearance_class "kicad_default")
    (via_rule "kicad_default")
    (rule
      (width 250.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)